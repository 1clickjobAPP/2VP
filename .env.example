# Where /api/lead forwards submissions. Use a Zapier/Make/n8n catch-hook,
# Slack incoming webhook, or your own CRM endpoint. If unset, leads are
# logged to the server console (useful in local dev).
LEAD_WEBHOOK_URL=

# Optional. If set, /api/lead sends this value as the `x-2vp-secret`
# header on every webhook POST so you can authenticate inbound leads.
LEAD_WEBHOOK_SECRET=
